# Canonical origin used for metadataBase, sitemap, and JSON-LD.
# No trailing slash. Defaults to https://home-gym-fit.pages.dev when unset.
NEXT_PUBLIC_SITE_URL=https://home-gym-fit.pages.dev

# Appended to manufacturer_url only when the product has
# affiliates.rep_affiliate_eligible === true and both values are non-empty.
# Example: NEXT_PUBLIC_REP_AFFILIATE_PARAM=ref
#          NEXT_PUBLIC_REP_AFFILIATE_VALUE=your-id
NEXT_PUBLIC_REP_AFFILIATE_PARAM=
NEXT_PUBLIC_REP_AFFILIATE_VALUE=

# When set, products with affiliates.amazon_asin render
# https://www.amazon.com/dp/${asin}?tag=${NEXT_PUBLIC_AMAZON_TAG}
NEXT_PUBLIC_AMAZON_TAG=
