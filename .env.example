# Amazon Associates tracking ID. Added as ?tag= only when a product ASIN is set.
NEXT_PUBLIC_AMAZON_TAG=

# REP Fitness affiliate query string from the affiliate dashboard after approval, for example ref=xyz.
NEXT_PUBLIC_REP_AFFILIATE_PARAMS=

# Google Search Console meta tag content. No tag is emitted when empty.
NEXT_PUBLIC_GSC_VERIFICATION=

# Canonical origin with no trailing slash. Defaults to https://home-gym-fit.pages.dev when empty.
NEXT_PUBLIC_SITE_URL=
